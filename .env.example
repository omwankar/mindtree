# Copy to .env or set keys in the in-app Settings panel.
# Settings UI values take precedence over .env.
# NEVER commit .env — it is gitignored.

# Groq — screen vision + free Whisper STT (https://console.groq.com/keys)
GROQ_API_KEY=

# Hugging Face — free STT alternative (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=

# OpenRouter — optional AI fallback (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Anthropic — optional Claude direct (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI — paid Whisper fallback
OPENAI_API_KEY=

# ElevenLabs — optional text-to-speech (https://elevenlabs.io)
ELEVENLABS_API_KEY=
